# Lager - Einstellungen für docker compose (Vorlage, ohne echte Werte).
#
#   cp .env.example .env      dann die gewünschten Zeilen einkommentieren und anpassen
#
# ".env" wird nicht eingecheckt (steht in .gitignore). Alles hier ist optional: ohne .env startet
# "docker compose up --build" mit sicheren Standardwerten. Steht ein Wert mit Sonderzeichen ($, #, Leerzeichen) darin,
# in einfache Anführungszeichen setzen: KEY='wert'. Die Schreibweise mit "__" ist die Umgebungsvariable von ASP.NET Core
# für einen Konfigurationsschlüssel mit ":" (Auth__BootstrapAdminPassword = Auth:BootstrapAdminPassword).
# docker-compose.yml reicht nur die Einstellungen an Lager weiter, die dort im Block "environment" stehen (nicht die ganze
# Datei, damit z. B. das Root-Passwort der Datenbank nie im Lager-Container landet); weitere dort ergänzen.

# --- Erreichbarkeit -------------------------------------------------------------------------------------------------

# Port auf dem Docker-Host (Standard 8080). Mit vorangestellter Adresse nur vom eigenen Rechner erreichbar,
# z. B. wenn Caddy davorsteht: 127.0.0.1:8080
#LAGER_PORT=8080

# Erlaubte Host-Namen, Semikolon-getrennt. Standard: nur localhost. Für Zugriff im LAN (IP oder Rechnername) oder unter einer
# Domain eintragen, sonst antwortet die API mit 400. localhost bleibt immer zusätzlich erlaubt (Healthcheck).
#AllowedHosts=lager.example.com;192.168.1.20

# Nur bei einem anderen Origin als dem der mitgelieferten Oberfläche nötig (die läuft unter demselben Origin ohne CORS).
#Cors__AllowedOrigins__0=https://lager.example.com

# --- Hinter einem Reverse-Proxy / HTTPS (Profil "https", deploy/Caddyfile) ------------------------------------------------

# Öffentlicher Name für Caddy (Standard localhost).
#LAGER_DOMAIN=lager.example.com

# Proxy-Header auswerten (echte Client-IP für das Rate-Limit). Nur einschalten, wenn wirklich ein Proxy davorsteht, und nur
# von dessen Netz (Docker-Standardnetze liegen in 172.16.0.0/12; bei anderem Netz anpassen).
#Security__ForwardedHeaders__Enabled=true
#Security__ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

# --- Erster Start / Anmeldung ---------------------------------------------------------------------------------------------

# Passwort des ersten Admin-Kontos (Benutzer "admin"). Ohne Angabe erzeugt der erste Start ein Einmalpasswort und gibt es
# genau einmal im Container-Log aus: docker compose logs lager. In beiden Fällen ist beim ersten Login ein Passwortwechsel
# Pflicht. Das Passwort muss mindestens 10 Zeichen haben.
#Auth__BootstrapAdminPassword=<eigenes-starkes-passwort>

# JWT-Signing-Key: Standard ist eine Datei auf dem Volume (/data/jwt.key), die beim ersten Start erzeugt wird. Alternativ
# ein eigener Key (mindestens 32 Zeichen, z. B. mit: openssl rand -base64 48); er hat Vorrang vor der Datei.
#Jwt__SigningKey=<zufaelliger-key>

# --- Daten ----------------------------------------------------------------------------------------------------------------

# Restore eines Backups über die API ist in Production gesperrt. Zum Einspielen freigeben, dann neu starten
# (docker compose up -d). Backups enthalten Passwort-Hashes und sind unverschlüsselt (Ziel: /data/backups auf dem Volume).
#Backup__AllowRestore=true

# Automatisches Backup: tägliche Startzeit als HH:mm in UTC (ohne Angabe: kein Zeitplan) und Zahl der aufbewahrten Backups
# (Standard 14; 0 oder weniger = nie automatisch löschen).
#Backup__Schedule=02:00
#Backup__RetentionCount=14

# Demo-Modus: legt in eine LEERE Datenbank einen erfundenen Betrieb mit Historie und Demo-Benutzern an (docs/features/demo-modus.md).
# Demo-Daten gehören nicht in ein Produktivsystem. Das Image läuft als Production und verlangt deshalb zum Ausprobieren beides;
# die Zugangsdaten der Demo-Benutzer stehen einmalig im Container-Log (docker compose logs lager):
#Demo__Enabled=true
#Demo__AllowInProduction=true

# MySQL statt SQLite (docker compose -f docker-compose.yml -f docker-compose.mysql.yml up --build): beide Passwörter setzen.
#LAGER_DB_PASSWORD=<passwort-der-anwendung>
#LAGER_DB_ROOT_PASSWORD=<passwort-des-root-kontos>

# --- Logging --------------------------------------------------------------------------------------------------------------

# Mindest-Level (Verbose, Debug, Information, Warning, Error). Standard: Information; Logdateien liegen in /data/logs.
#Serilog__MinimumLevel__Default=Debug
#Logging__RetainedFileCount=14
