# Zeilenenden: Git normalisiert Textdateien, im Repository liegt immer LF.
# (Passt zu .editorconfig: end_of_line = lf)
* text=auto eol=lf

# Windows-spezifische Dateien brauchen CRLF
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell-Skripte und Container-Dateien: immer LF (brechen unter CRLF auf Linux)
*.sh text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf

# Binaerdateien: nie umwandeln, nie diffen
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.db binary
*.sqlite binary
