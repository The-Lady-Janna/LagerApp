{
  // Logging (Serilog, siehe LagerLogging in Program.cs): Ein Abschnitt "Logging:LogLevel" wirkt nicht mehr - Serilog ersetzt die
  // Microsoft-Logging-Konfiguration. Das Level der Entwicklung steht deshalb hier im Abschnitt "Serilog".
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  // Nur für die lokale Entwicklung: Demo-Daten beim Start anlegen. Kein Signing-Key und kein Passwort hier -
  // Development nutzt einen flüchtigen Zufallskey, das Bootstrap-Einmalpasswort erscheint auf der Konsole.
  "Database": {
    "Seed": true
  }
}
