{
  // Adresse/Port: nicht hier, sondern per Umgebungsvariable ASPNETCORE_URLS (z. B. "http://+:8080") oder Kestrel:Endpoints.
  // Ohne Angabe lauscht ein veröffentlichtes Programm auf http://localhost:5000; unter `dotnet run` gilt der Port aus
  // Properties/launchSettings.json (5099). Bewusst kein "Urls" in dieser Datei: es würde ASPNETCORE_URLS überstimmen.

  // Logging (Serilog, siehe LagerLogging in Program.cs). Serilog ersetzt die Microsoft-Logging-Konfiguration: ein Abschnitt
  // "Logging:LogLevel" wirkt nicht mehr. Mindest-Level und Overrides stehen im Abschnitt "Serilog", z. B. per Umgebungsvariable
  //   Serilog__MinimumLevel__Default=Debug
  //   Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Information
  // oder hier als
  //   "Serilog": { "MinimumLevel": { "Default": "Debug", "Override": { "Microsoft.AspNetCore": "Information" } } }
  // Directory: Verzeichnis der Logdateien (lager-JJJJMMTT.log), relativ zum Arbeitsverzeichnis des Prozesses. Für Dienst-
  // oder Docker-Betrieb einen festen Pfad setzen (Umgebungsvariable Logging__Directory, im Docker-Image /data/logs).
  // RetainedFileCount: so viele Tagesdateien bleiben erhalten.
  "Logging": {
    "Directory": "logs",
    "RetainedFileCount": 14
  },

  // Host-Header-Filter (Semikolon-getrennt). Standard: nur lokaler Zugriff. Für den Betrieb hinter einem
  // Reverse-Proxy oder im LAN den eigenen Hostnamen eintragen, z. B. per Umgebungsvariable
  // AllowedHosts="lager.example.com" (mehrere mit ";" trennen).
  "AllowedHosts": "localhost;127.0.0.1;[::1]",

  // Seed ist VERALTET (Alias für den kleinen Altbestand-Datensatz, mit Warnung im Log): stattdessen Demo:Enabled (siehe unten).
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=lager.db",
    "Seed": false
  },

  // Demo-Modus, standardmäßig AUS. Enabled=true (Kurzform: Umgebungsvariable LAGER_DEMO=1) legt beim Start in eine LEERE Datenbank
  // einen neutralen, erfundenen Demo-Datensatz mit 60 Tagen Historie und Demo-Benutzern an (nie Reseed). Die zufälligen Passwörter der
  // Demo-Benutzer stehen einmalig in der Konsole. In der Umgebung Production bricht der Start mit Enabled=true ab, außer
  // AllowInProduction=true steht ausdrücklich dabei. Details: docs/features/demo-modus.md.
  "Demo": {
    "Enabled": false,
    "AllowInProduction": false
  },

  // JWT: Der Signing-Key steht bewusst NICHT hier. Beim Start wird er aufgelöst aus
  //   1. Jwt:SigningKey  - Umgebungsvariable Jwt__SigningKey bzw. Secret-Store (mind. 32 Bytes, z. B. `openssl rand -base64 48`)
  //   2. Jwt:KeyFile     - Pfad einer Datei (absolut oder relativ zum Anwendungsverzeichnis); wird beim ersten Start
  //                        mit einem Zufallskey angelegt und danach wiederverwendet (z. B. auf einem Docker-Volume)
  //   3. nur Development - flüchtiger Zufallskey (Tokens verfallen beim Neustart)
  // Ohne Key startet die API außerhalb von Development nicht.
  "Jwt": {
    "Issuer": "Lager",
    "Audience": "Lager",
    "LifetimeMinutes": 480
  },

  // Bootstrap-Admin: wird beim allerersten Start angelegt, wenn die Users-Tabelle leer ist. Es gibt kein
  // Default-Passwort. Ohne Auth:BootstrapAdminPassword (Umgebungsvariable/Secret, nie hier eintragen) wird ein
  // Einmalpasswort erzeugt und einmalig auf der Konsole ausgegeben. Der Erst-Login erzwingt den Passwortwechsel.
  // Kontosperre: nach MaxFailedAttempts Fehlversuchen für LockoutMinutes.
  "Auth": {
    "BootstrapAdminUsername": "admin",
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  // RequireHttps: HSTS + Weiterleitung auf HTTPS (nur mit ermittelbarem Port: HttpsPort, ASPNETCORE_HTTPS_PORT
  //   oder https-Adresse in ASPNETCORE_URLS). Hinter einem TLS-terminierenden Proxy aus lassen.
  // Rate-Limit je Client-IP und Minute (429 mit Retry-After); im Environment "Testing" aus.
  // ForwardedHeaders: nur aktivieren, wenn die API hinter einem Reverse-Proxy läuft; KnownProxies/KnownNetworks
  //   (CIDR, z. B. "10.0.0.0/8") begrenzen, wessen X-Forwarded-*-Headern vertraut wird (Standard: nur Loopback).
  "Security": {
    "RequireHttps": false,
    "LoginRateLimitPerMinute": 10,
    "GlobalRateLimitPerMinute": 600,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
